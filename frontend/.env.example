# URLs RELATIVAS: el dev server de Vite proxya /api al backend (ver vite.config.ts).
# Así la WebView (tauri.localhost en Android / localhost:1420 en desktop) habla
# con su mismo origin y la cookie de sesión (SameSite=Lax) se envía en cada request.
VITE_API_URL=/api

# Host del backend al que Vite proxya /api. Ajusta si tu backend corre en otra IP/puerto.
BACKEND_HOST=http://192.168.0.10:3000
VITE_BACKEND_HOST=http://192.168.0.10:3000
